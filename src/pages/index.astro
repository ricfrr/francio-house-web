---
import Base from '../layouts/Base.astro';
import Outside from '../components/Outside.astro';
import Topbar from '../components/Topbar.astro';
import NextEvent from '../components/NextEvent.astro';
import Upcoming from '../components/Upcoming.astro';
import Archive from '../components/Archive.astro';
import HouseRoom from '../components/HouseRoom.astro';
import Footer from '../components/Footer.astro';
import JungleSprite from '../components/decor/JungleSprite.astro';
import { getSplitEvents } from '../lib/events';

const { upcoming, past } = await getSplitEvents();
// A few candidates for the hero, in case the next one ends before the next rebuild.
const candidates = upcoming.slice(0, 3);
---

<Base intro>
  <a class="skip-link" href="#next">Skip to the next concert</a>
  <Outside />
  <JungleSprite />
  <div id="interior">
    <Topbar home />
    <main>
      <h1 class="sr-only">Francio House — concerts and creative nights in a private house</h1>
      <NextEvent candidates={candidates} />
      <Upcoming events={upcoming.slice(1)} />
      <Archive events={past} />
      <HouseRoom />
    </main>
    <Footer home />
  </div>
</Base>

<script>
  import { initInside } from '../scripts/inside';
  initInside();
</script>
