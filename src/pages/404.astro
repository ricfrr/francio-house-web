---
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import JungleSprite from '../components/decor/JungleSprite.astro';
import OwlFace from '../components/decor/OwlFace.astro';
import { ui } from '../i18n/ui';
// GitHub Pages serves this one page for every missing address, so it speaks both languages.
const { it, en } = ui;
---

<Base lang="it" title="Porta sbagliata · Wrong door">
  <JungleSprite />
  <Topbar lang="it" langHref="/en/" />
  <main class="room lost">
    <OwlFace />
    <h1 class="room-title">{it.lost.title[0]}<br />{it.lost.title[1]}</h1>
    <p>{it.lost.text}</p>
    <p lang="en" class="lost__en">{en.lost.text}</p>
    <div class="lost__actions">
      <a class="btn btn--sun" href="/">{it.lost.back}</a>
      <a class="btn btn--light" href="/en/" lang="en">{en.lost.back}</a>
    </div>
  </main>
</Base>

<script>
  import { initInside } from '../scripts/inside';
  initInside();
</script>

<style>
  .lost {
    --room-bg: var(--sky);
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 20px;
    padding: 120px var(--gutter) 80px;
    text-align: center;
  }

  .lost p {
    margin: 0;
  }

  .lost__en {
    opacity: 0.7;
    font-style: italic;
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  .lost :global(.owl) {
    width: min(70vw, 320px);
  }
</style>
