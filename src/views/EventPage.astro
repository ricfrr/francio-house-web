---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import EventLinks from '../components/EventLinks.astro';
import Icon from '../components/Icon.astro';
import JungleSprite from '../components/decor/JungleSprite.astro';
import Leaf from '../components/decor/Leaf.astro';
import type { HouseEvent } from '../lib/events';
import { googleCalendarUrl } from '../lib/calendar';
import { formatDayMonth, formatLong, formatShort, formatWeekday } from '../lib/time';
import { ui, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  event: HouseEvent;
  prev?: HouseEvent;
  next?: HouseEvent;
}
const { lang, event: e, prev, next } = Astro.props;
const t = ui[lang];
const home = localePath(lang, '/');

const isPast = e.end <= new Date();
const share = await getImage({ src: e.poster, width: 1200, format: 'jpg' });
const isUrl = (s?: string) => !!s && /^(https?:|mailto:)/.test(s);
const heading = e.title === e.artist ? e.artist : `${e.artist} — ${e.title}`;
---

<Base lang={lang} title={heading} description={e.summary} image={share.src} themeColor={e.accent}>
  <JungleSprite />
  <Topbar lang={lang} />
  <main class="event room" style={`--room-bg:${e.accent};--room-ink:${e.ink};--accent:${e.accent}`}>
    <Leaf kind="monstera" class="event__leaf event__leaf--a" />
    <Leaf kind="palm" class="event__leaf event__leaf--b" />

    <div class="wrap event__grid">
      <a class="event__back mono" href={`${home}${isPast ? '#archive' : '#upcoming'}`}>
        <Icon name="back" /> {t.event.back}
      </a>

      <figure class="event__poster" data-tilt>
        <span class="tape" style="left:10%;top:-12px;transform:rotate(-6deg)"></span>
        <span class="tape" style="right:10%;top:-12px;transform:rotate(7deg)"></span>
        <Image
          src={e.poster}
          alt={e.posterAlt}
          widths={[480, 720, 1000, 1400]}
          sizes="(min-width: 960px) 44vw, 90vw"
          loading="eager"
          fetchpriority="high"
        />
        <span class="event__shine" aria-hidden="true"></span>
      </figure>

      <div class="event__info">
        {
          isPast ? (
            <p class="event__tag hand">{t.event.past}</p>
          ) : (
            <p class="event__tag hand" data-ends={e.end.toISOString()}>
              <span data-rel={e.start.toISOString()} data-rel-end={e.end.toISOString()}>
                {t.event.upcoming}
              </span>
            </p>
          )
        }
        <p class="event__when mono">
          <time datetime={e.start.toISOString()}>
            {formatWeekday(e.start, lang)} {formatDayMonth(e.start, lang)}
          </time>
          <span>{formatLong(e.start, lang)} · {e.time}</span>
        </p>
        <h1 class="event__artist">{e.artist}</h1>
        {e.title !== e.artist && <p class="event__title">{e.title}</p>}
        {e.genre && <p class="event__genre mono">{e.genre}</p>}
        {
          e.lineup.length > 0 && (
            <p class="event__lineup">
              <span class="mono">{t.event.with}</span> {e.lineup.join(' · ')}
            </p>
          )
        }

        {
          !isPast && (
            <div class="event__practical" data-ends={e.end.toISOString()}>
              <dl class="event__stub">
                {e.doors && (
                  <div>
                    <dt>{t.next.doors}</dt>
                    <dd>{e.doors}</dd>
                  </div>
                )}
                <div>
                  <dt>{t.next.music}</dt>
                  <dd>{e.time}</dd>
                </div>
                <div class="wide">
                  <dt>{t.next.entry}</dt>
                  <dd>{e.entry}</dd>
                </div>
                <div class="wide">
                  <dt>{t.next.where}</dt>
                  <dd>{t.event.where}</dd>
                </div>
                {e.rsvp && !isUrl(e.rsvp) && (
                  <div class="wide">
                    <dt>{t.next.rsvp}</dt>
                    <dd>{e.rsvp}</dd>
                  </div>
                )}
              </dl>
              <div class="event__actions">
                {isUrl(e.rsvp) && (
                  <a class="btn btn--sun" href={e.rsvp} target="_blank" rel="noopener">
                    {t.next.rsvp} <Icon name="arrow" />
                  </a>
                )}
                <a class="btn btn--light" href={e.icsUrl} download>
                  <Icon name="calendar" /> .ics
                </a>
                <a class="btn btn--light" href={googleCalendarUrl(e)} target="_blank" rel="noopener">
                  <Icon name="calendar" /> {t.event.gcal}
                </a>
              </div>
            </div>
          )
        }

        <EventLinks links={e.links} label={t.event.online(e.artist)} lang={lang} class="event__links" />

        <div class="event__body">
          <Fragment set:html={e.html} />
        </div>

        {
          e.recordings.length > 0 && (
            <div class="event__recordings">
              <h2 class="event__h">{t.event.listen}</h2>
              <ul>
                {e.recordings.map((r) => (
                  <li>
                    <a href={r.url} target="_blank" rel="noopener">
                      <Icon name="play" />
                      {r.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>

    {
      e.photos.length > 0 && (
        <section class="wrap event__photos" aria-label={t.event.photos}>
          <h2 class="event__h">{t.event.photos}</h2>
          <ul>
            {e.photos.map((photo, i) => (
              <li style={`--rot:${i % 2 ? 2.5 : -2}deg`}>
                <Image src={photo} alt={t.event.photoAlt(e.artist, formatShort(e.start))} widths={[480, 800, 1200]} sizes="(min-width: 900px) 40vw, 90vw" loading="lazy" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="wrap event__pager" aria-label={t.event.more}>
      {
        prev ? (
          <a href={prev.url} class="event__pager-link">
            <span class="mono">← {t.event.earlier} · {formatShort(prev.start)}</span>
            <b>{prev.artist}</b>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={next.url} class="event__pager-link event__pager-link--next">
            <span class="mono">{t.event.later} · {formatShort(next.start)} →</span>
            <b>{next.artist}</b>
          </a>
        )
      }
    </nav>
  </main>
  <Footer lang={lang} />
</Base>

<script>
  import { initInside } from '../scripts/inside';
  initInside();
</script>

<style>
  .event {
    min-height: 100vh;
    padding: clamp(100px, 12vw, 150px) 0 clamp(60px, 8vw, 100px);
    overflow: clip;
  }

  .event :global(.event__leaf) {
    position: absolute;
    z-index: -1;
    opacity: 0.85;
    pointer-events: none;
  }

  .event :global(.event__leaf--a) {
    width: clamp(220px, 26vw, 420px);
    right: -80px;
    top: 80px;
    color: rgb(0 0 0 / 0.16);
    transform: rotate(-140deg);
  }

  .event :global(.event__leaf--b) {
    width: clamp(220px, 24vw, 380px);
    left: -90px;
    bottom: 120px;
    color: rgb(0 0 0 / 0.14);
    transform: rotate(40deg);
  }

  .event__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .event__back {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    padding: 8px 14px 8px 10px;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .event__back:hover {
    background: var(--room-ink);
    color: var(--room-bg);
  }

  .event__back :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .event__poster {
    position: sticky;
    top: 100px;
    margin: 0;
    transform: perspective(1000px) rotateX(var(--tx, 0deg)) rotateY(var(--ty, 0deg)) rotate(-1.5deg);
    transition: transform 0.6s var(--ease-out);
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.35));
  }

  .event__poster.is-tilting {
    transition-duration: 0.12s;
  }

  .event__poster img {
    width: 100%;
    background: var(--paper);
  }

  .event__shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at var(--sx, 30%) var(--sy, 20%), rgb(255 255 255 / 0.32), transparent 45%);
    mix-blend-mode: soft-light;
    opacity: var(--shine, 0);
    transition: opacity 0.3s;
  }

  .event__tag {
    display: inline-block;
    margin: 0 0 14px;
    padding: 4px 14px 6px;
    background: var(--ink);
    color: var(--sun);
    font-size: 1.1rem;
    transform: rotate(-3deg);
    border-radius: 3px;
  }

  .event__when {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    align-items: baseline;
    margin: 0 0 12px;
    font-size: 0.85rem;
  }

  .event__when time {
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 700;
    text-transform: uppercase;
  }

  .event__artist {
    font-size: clamp(3.2rem, 8vw, 7.8rem);
    font-variation-settings: 'wdth' 75;
    line-height: 0.84;
    letter-spacing: -0.035em;
    margin-bottom: 10px;
    overflow-wrap: anywhere;
  }

  .event__title {
    font-size: clamp(1.3rem, 2.2vw, 1.9rem);
    font-style: italic;
    font-weight: 300;
    margin: 0 0 6px;
  }

  .event__genre,
  .event__lineup {
    margin: 0 0 6px;
    font-size: 0.95rem;
  }

  .event__practical {
    margin: 26px 0;
  }

  .event__stub {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 0 20px;
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 6px;
    box-shadow: 5px 5px 0 var(--ink);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .event__stub > div {
    padding: 10px 14px;
    border-bottom: 1.5px dashed rgb(21 16 26 / 0.35);
  }

  .event__stub > div:last-child {
    border-bottom: 0;
  }

  .event__stub .wide {
    grid-column: 1 / -1;
  }

  .event__stub dt {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.65;
  }

  .event__stub dd {
    margin: 0;
    font-weight: 700;
  }

  .event__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .event :global(.event__links) {
    margin: 24px 0;
  }

  .event__body {
    margin-top: 28px;
    padding: clamp(20px, 3vw, 32px);
    background: var(--paper);
    color: var(--ink);
    border-radius: 8px;
    box-shadow: 0 14px 30px rgb(0 0 0 / 0.18);
    font-size: 1.08rem;
  }

  .event__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .event__h {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-variation-settings: 'wdth' 80;
    margin: 0 0 16px;
  }

  .event__recordings {
    margin-top: 36px;
  }

  .event__recordings ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event__recordings a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 10px 12px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .event__recordings a:hover {
    background: var(--sun);
    color: var(--ink);
  }

  .event__photos {
    margin-top: clamp(60px, 8vw, 110px);
  }

  .event__photos ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event__photos li {
    padding: 10px;
    background: #fbfaf5;
    box-shadow: 0 16px 30px rgb(0 0 0 / 0.3);
    transform: rotate(var(--rot));
  }

  .event__photos img {
    width: 100%;
  }

  .event__pager {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: clamp(60px, 8vw, 110px);
    padding-top: 28px;
    border-top: 2px solid currentColor;
  }

  .event__pager-link {
    display: grid;
    gap: 4px;
    text-decoration: none;
  }

  .event__pager-link b {
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    font-variation-settings: 'wdth' 78;
    line-height: 1;
  }

  .event__pager-link:hover b {
    text-decoration: underline;
  }

  .event__pager-link--next {
    text-align: right;
  }

  @media (max-width: 860px) {
    .event__grid {
      grid-template-columns: 1fr;
    }

    .event__poster {
      position: relative;
      top: 0;
      width: min(100%, 520px);
      justify-self: center;
    }
  }
</style>
