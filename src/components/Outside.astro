---
// The street: the first thing visitors see. Hidden for returning visitors (see Base.astro)
// and when JavaScript is off, in which case the site simply starts inside.
import { ui, switchPath, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const timing = [
  [0, 0.15],
  [0.19, 0.34],
  [0.39, 0.55],
  [0.6, 0.73],
  [0.76, 0.86],
];
const captions = t.outside.captions.map((text, i) => ({ text, from: timing[i][0], to: timing[i][1] }));
const other = t.lang.other;
---

<div id="outside" class="outside" data-outside role="region" aria-label={t.outside.region}>
  <!-- plain sky while the 3D street loads; it must be hidden afterwards, or it would cover the view through the door -->
  <div class="outside__sky" aria-hidden="true"></div>
  <canvas class="outside__canvas" data-street-canvas aria-hidden="true"></canvas>

  <div class="outside__loading" role="status">
    <svg class="outside__loading-house" viewBox="0 0 140 130" fill="none" aria-hidden="true">
      <path d="M14 55 70 13l56 42M26 47v69h88V47" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M89 27V14h15v24" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
      <rect class="outside__loading-light" x="40" y="60" width="18" height="22" rx="2" fill="var(--sun)" />
      <rect class="outside__loading-light" x="82" y="60" width="18" height="22" rx="2" fill="var(--sun)" />
      <path class="outside__loading-light" d="M61 116V94a9 9 0 0 1 18 0v22" fill="var(--pink)" />
      <path d="M14 116h112" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
    </svg>
    <p class="mono">{t.outside.loading}</p>
  </div>

  <div class="outside__ui">
    <div class="outside__top">
      <p class="outside__plate mono" aria-hidden="true">francio.house</p>
      <a class="outside__lang mono" href={`${switchPath(Astro.url.pathname, other)}?intro`} hreflang={other} lang={other} aria-label={t.lang.switchLabel} data-track="lang-switch">
        {t.lang.short}
      </a>
    </div>
    <button class="outside__skip mono" type="button" data-skip data-track="intro-skip">{t.outside.skip} <span aria-hidden="true">→</span></button>

    <div class="outside__captions" aria-hidden="true">
      {
        captions.map((c) => (
          <p data-from={c.from} data-to={c.to}>
            {c.text}
          </p>
        ))
      }
    </div>

    <div class="outside__bell">
      <button class="bell" type="button" data-enter data-track="intro-enter">
        <span class="bell__label" aria-hidden="true">FRANCIO</span>
        <span class="bell__button" aria-hidden="true"></span>
        <span class="bell__text">{t.outside.enter}</span>
      </button>
      <p class="outside__hint mono" aria-hidden="true">{t.outside.hint} <span>↓</span></p>
    </div>
  </div>
</div>
<div class="street-spacer" data-spacer aria-hidden="true"></div>

<style>
  .outside,
  .street-spacer {
    display: none;
  }

  :global(html[data-mode='outside']) .outside {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 40;
    height: 100vh;
    height: 100lvh;
    transition: opacity 0.5s var(--ease-out);
  }

  :global(html[data-mode='outside']) .street-spacer {
    display: block;
    height: 620vh;
  }

  :global(html[data-mode='outside'][data-motion='reduced']) .street-spacer {
    height: 60vh;
  }

  .outside.is-leaving {
    opacity: 0;
  }

  .outside__sky,
  .outside__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .outside__sky {
    background: linear-gradient(#1b5fe0, #9fd0ff 70%, #a8a27f 70%);
  }

  .outside__canvas {
    opacity: 0;
    transition: opacity 0.8s;
  }

  .outside.is-3d .outside__canvas {
    opacity: 1;
  }

  /* the sky must disappear entirely once the street is drawn, or it would cover the view through the door */
  .outside.is-3d .outside__sky {
    visibility: hidden;
    transition: visibility 0s linear 0.9s;
  }

  .outside__loading {
    position: absolute;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: 18px;
    width: calc(100% - var(--gutter) * 2);
    color: #fff;
    text-align: center;
    pointer-events: none;
    transition: opacity 0.25s, visibility 0s linear 0.25s;
  }

  .outside__loading-house {
    width: 120px;
    filter: drop-shadow(0 4px 12px rgb(0 20 60 / 0.2));
  }

  .outside__loading p {
    margin: 0;
    font-size: 0.85rem;
    text-shadow: 0 1px 8px rgb(0 20 60 / 0.4);
  }

  .outside__loading-light {
    animation: house-light 1.8s ease-in-out infinite;
  }

  .outside__loading-light:nth-of-type(2) {
    animation-delay: 0.3s;
  }

  path.outside__loading-light {
    animation-delay: 0.6s;
  }

  @keyframes house-light {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  .outside.is-3d .outside__loading {
    opacity: 0;
    visibility: hidden;
  }

  .outside:not(.is-3d) .outside__captions,
  .outside:not(.is-3d) .outside__bell {
    visibility: hidden;
  }

  .outside__ui {
    position: absolute;
    inset: 0;
    color: #fff;
    opacity: var(--ui, 1);
    pointer-events: none;
  }

  .outside__ui > * {
    pointer-events: auto;
  }

  .outside__top {
    position: absolute;
    top: max(16px, env(safe-area-inset-top));
    left: var(--gutter);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .outside__lang {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid rgb(255 255 255 / 0.8);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.12);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .outside__lang:hover {
    background: #fff;
    color: var(--ink);
  }

  .outside__plate {
    margin: 0;
    padding: 6px 10px;
    font-size: 0.78rem;
    color: #2b2b2b;
    background: #f3f0ea;
    border: 1px solid #c9c4ba;
    border-radius: 3px;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
  }

  .outside__skip {
    position: absolute;
    top: max(14px, env(safe-area-inset-top));
    right: var(--gutter);
    min-height: 40px;
    padding: 8px 14px;
    border: 1.5px solid rgb(255 255 255 / 0.8);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.12);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .outside__skip:hover {
    background: #fff;
    color: var(--ink);
  }

  .outside__captions {
    position: absolute;
    left: 50%;
    bottom: calc(150px + env(safe-area-inset-bottom));
    width: min(90vw, 760px);
    transform: translateX(-50%);
    text-align: center;
  }

  .outside__captions p {
    position: absolute;
    inset: auto 0 0;
    margin: 0;
    font-size: clamp(1.5rem, 3.4vw, 2.6rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.1;
    text-shadow:
      0 2px 24px rgb(0 20 60 / 0.45),
      0 1px 2px rgb(0 0 0 / 0.3);
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.8s var(--ease-out);
  }

  .outside__captions p.is-on {
    opacity: 1;
    transform: none;
  }

  .outside__bell {
    position: absolute;
    left: 50%;
    bottom: max(24px, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  /* an intercom plate, like the one by the gate */
  .bell {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 10px 20px 10px 10px;
    border: 1px solid #a9a397;
    border-radius: 12px;
    background: linear-gradient(170deg, #f1eee8, #cfc9bd);
    color: var(--ink);
    box-shadow:
      inset 0 1px 0 #fff,
      0 14px 34px rgb(0 0 0 / 0.28);
    cursor: pointer;
    transition: transform 0.3s var(--ease-spring);
  }

  .bell:hover {
    transform: translateY(-3px) rotate(-1deg);
  }

  .bell__label {
    padding: 5px 9px 4px;
    background: #141414;
    color: #f6f6f6;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.24em;
    border-radius: 2px;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.25);
    transform: rotate(-1.5deg);
  }

  .bell__button {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, #c4beb1 58%, #8d877b);
    box-shadow:
      inset 0 -2px 3px rgb(0 0 0 / 0.3),
      0 2px 3px rgb(0 0 0 / 0.3);
  }

  .bell__button::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid #ff2f8c;
    opacity: 0;
    animation: ring 1.07s ease-out infinite;
  }

  .bell:hover .bell__button::after,
  .bell:focus-visible .bell__button::after {
    opacity: 1;
  }

  .bell:active .bell__button {
    transform: scale(0.92);
    box-shadow: inset 0 2px 4px rgb(0 0 0 / 0.4);
  }

  @keyframes ring {
    from {
      transform: scale(0.9);
      opacity: 1;
    }
    to {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  .bell__text {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.92rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    .bell {
      gap: 10px;
      padding-right: 14px;
    }

    .bell__label {
      font-size: 0.7rem;
      letter-spacing: 0.16em;
    }

    .bell__text {
      font-size: 0.8rem;
    }
  }

  .outside__hint {
    margin: 0;
    font-size: 0.75rem;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.4);
  }

  .outside__hint span {
    display: inline-block;
    animation: bob 1.6s ease-in-out infinite;
  }

  @keyframes bob {
    50% {
      transform: translateY(4px);
    }
  }
</style>

<script>
  import { initOutside } from './intro/controller';
  initOutside();
</script>
