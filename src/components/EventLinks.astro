---
import Icon from './Icon.astro';
import { linkLabel } from '../lib/events';
import type { Lang } from '../i18n/ui';

interface Props {
  links: Record<string, string>;
  /** Accessible name of the list, e.g. "Marea Alta online". */
  label: string;
  lang: Lang;
  class?: string;
}
const { links, label, lang, class: className = '' } = Astro.props;
const entries = Object.entries(links);
---

{
  entries.length > 0 && (
    <ul class:list={['links', className]} aria-label={label}>
      {entries.map(([key, url]) => (
        <li>
          <a class="chip" href={url} target="_blank" rel="noopener" data-track={`artist-link-${key}`}>
            <Icon name={key} />
            {linkLabel(key, lang)}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
